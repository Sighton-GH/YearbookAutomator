{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sighton-yearbook-website",
  "compatibility_date": "2026-06-21",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "yearbook.sighton.ca",
      "custom_domain": true
    }
  ]
}
