---
import { SiteTopBar } from "../components/SiteTopBar";
import { SiteFooter } from "../components/SiteFooter";
import "../styles/index.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Custom Flow Automator assembles yearbook grad spreads automatically: upload your template, roster, and portraits, and get print-ready pages with names, quotes, and baby photos placed."
    />
    <meta name="theme-color" content="#090d11" />
    <link rel="icon" type="image/png" href="/assets/Sighton_Logo.png" />
    <link rel="apple-touch-icon" href="/assets/Sighton_Logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="ss-shell">
      <SiteTopBar currentPath={currentPath} client:load />
      <main class="ss-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
