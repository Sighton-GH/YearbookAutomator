.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
tool/server/.venv/
venv/
ENV/

# --- Node / Vite / Astro ---
tool/web/node_modules/
tool/web/dist/
tool/web/.env
website/node_modules/
