# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
server/.venv/
venv/
ENV/

# --- Node / Vite ---
web/node_modules/
web/dist/

# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
.vscode/

# --- App: user/workspace data (DO NOT COMMIT) ---
# All per-workspace data lives under server/app/data/<workspace_id>/
# This includes uploads, spreadsheets, portraits, extracted images, masks, fonts, and outputs.
server/app/data/**

# Keep licensing/assets that are intended to be versioned
!server/app/data/_licenses/
!server/app/data/_licenses/**

# But don't commit secrets even if they live in _licenses
server/app/data/_licenses/secret.txt

# --- Optional: logs ---
*.log
