[Unit]
Description=Yearbook Mugshot Automator - Frontend (production static/proxy server)
After=network.target ymga-backend.service
Wants=ymga-backend.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=bryan
WorkingDirectory=/media/bryan/OptiData1/VS Code/Personal Projects/Yearbook Grad Mugshot Automator/tool/web
Environment=YMGA_FRONTEND_HOST=127.0.0.1
Environment=YMGA_FRONTEND_PORT=5173
Environment=YMGA_BACKEND_HOST=127.0.0.1
Environment=YMGA_BACKEND_PORT=8000
Environment=YMGA_FRONTEND_ALLOWED_HOSTS=127.0.0.1,localhost,yearbooktool.sighton.ca
ExecStart=/usr/bin/node production-server.js
Restart=on-failure
RestartSec=10
UMask=0077

CPUQuota=50%
CPUWeight=25
IOWeight=25
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
LimitNOFILE=2048
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
