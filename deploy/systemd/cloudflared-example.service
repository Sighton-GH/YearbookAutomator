[Unit]
Description=Cloudflare Tunnel for Yearbook Mugshot Automator
After=network-online.target ymga-frontend.service
Wants=network-online.target ymga-frontend.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/ymga-tunnel-token
Restart=on-failure
RestartSec=10

CPUQuota=50%
CPUWeight=25
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
