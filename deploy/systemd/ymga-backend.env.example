# Copy to /etc/ymga/ymga-backend.env, set owner root:root, and chmod 600.
# Generate independent random values; never commit the populated file.
YMGA_LICENSE_ADMIN_PASSWORD=replace-with-at-least-14-random-characters
YMGA_LICENSE_SECRET=replace-with-a-long-random-hmac-secret
YMGA_ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Point this at a root-owned, encrypted filesystem and migrate existing data
# before enabling it. The systemd unit permits /var/lib/ymga by default.
# YMGA_WORKSPACE_DATA_DIR=/var/lib/ymga

# Hosted origin and abuse/resource controls.
YMGA_ALLOWED_HOSTS=yearbooktool.sighton.ca,127.0.0.1,localhost
YMGA_MAX_REQUEST_BYTES=536870912
YMGA_MAX_STORED_FILE_BYTES=536870912
YMGA_MAX_WORKSPACE_BYTES=10737418240
YMGA_MAX_IMAGE_BYTES=104857600
YMGA_MAX_IMAGE_PIXELS=80000000
YMGA_MAX_SPREADSHEET_BYTES=26214400
YMGA_MAX_ARCHIVE_FILES=2000
YMGA_MAX_ARCHIVE_MEMBER_BYTES=104857600
YMGA_MAX_ARCHIVE_UNCOMPRESSED_BYTES=2147483648
YMGA_MAX_ARCHIVE_COMPRESSION_RATIO=250
YMGA_MAX_CONCURRENT_REQUESTS=64
YMGA_MAX_CONCURRENT_GENERATIONS=2
YMGA_MAX_GENERATION_PEOPLE=1000
YMGA_MAX_CONCURRENT_BACKGROUND_JOBS=2
YMGA_MAX_CONCURRENT_BACKGROUND_OPS=1
YMGA_NETWORK_UPLOAD_LIMIT_KBPS=25000
YMGA_NETWORK_DOWNLOAD_LIMIT_KBPS=50000
YMGA_CPU_MAX_THREADS=4
YMGA_CPU_THROTTLE_PERCENT=85
YMGA_CPU_LOW_PRIORITY=true
YMGA_GPU_MAX_CONCURRENT_OPS=1
